# Production Environment Variables
# Copy this file to .env.production and fill in your production values

# App Configuration
NEXT_PUBLIC_CURRENCY_SYMBOL='Rs'

# Clerk Authentication (Production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_production_clerk_publishable_key
CLERK_SECRET_KEY=your_production_clerk_secret_key

# Database (Neon or PostgreSQL)
DATABASE_URL="postgresql://username:password@hostname-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Inngest (Background Jobs)
INGEST_EVENT_KEY=your_production_inngest_event_key
INGEST_SIGNIN_KEY=your_production_inngest_signin_key

# ImageKit (File Storage)
IMAGEKIT_PUBLIC_KEY=your_production_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_production_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Prisma Configuration
PRISMA_CLIENT_ENGINE_TYPE="library"

# Prisma Optimize (Optional)
OPTIMIZE_API_KEY=your_production_optimize_api_key
